{
  "display_information": {
    "name": "Corrector de fallas",
    "description": "Corrige en Android y en iOS las fallas de Crashlytics que le piden en su hilo y responde con los PR.",
    "background_color": "#8c3b1f"
  },
  "features": {
    "bot_user": {
      "display_name": "Corrector de fallas",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "app_mentions:read",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": false
    }
  }
}
