{
  "name": "crashlytics-monitor",
  "version": "0.5.0",
  "private": true,
  "description": "Reporta cada falla nueva de Crashlytics en su propio hilo de Slack y la sigue hasta que se resuelve.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node src/check.js",
    "bugs": "node src/lifecycle.js",
    "render": "node src/render.js",
    "notify": "node src/notify.js",
    "simulate": "node src/simulate.js",
    "details": "node src/analyst/details.js",
    "reply": "node src/analyst/reply.js",
    "review:request": "node src/reviewer/request.js",
    "review:scan": "node src/reviewer/scan.js",
    "review:wait": "node src/reviewer/wait.js",
    "review:context": "node src/reviewer/context.js",
    "review:reply": "node src/reviewer/reply.js",
    "pr:opened": "node src/prs/opened.js",
    "tests:run": "node src/tester/run.js",
    "tests:reply": "node src/tester/reply.js",
    "tests:wait": "node src/tester/wait.js",
    "fix:request": "node src/fixer/request.js",
    "fix:scan": "node src/fixer/scan.js",
    "fix:context": "node src/fixer/context.js",
    "fix:reply": "node src/fixer/reply.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@grok/agent-sdk": "0.6.0"
  }
}
