{
  "name": "crashlytics-monitor",
  "version": "0.3.0",
  "private": true,
  "description": "Reporta cada hora las fallas de Crashlytics de la última versión en Slack, con análisis en el hilo.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node src/check.js",
    "render": "node src/render.js",
    "notify": "node src/notify.js",
    "simulate": "node src/simulate.js",
    "details": "node src/analyst/details.js",
    "reply": "node src/analyst/reply.js",
    "review:request": "node src/reviewer/request.js",
    "review:scan": "node src/reviewer/scan.js",
    "review:context": "node src/reviewer/context.js",
    "review:reply": "node src/reviewer/reply.js",
    "test": "node --test test/*.test.js"
  }
}
